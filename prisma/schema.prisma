generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../database/sso.db"
}

// SSO 用户表 - 统一身份
model User {
  id           Int            @id @default(autoincrement())
  uuid         String         @unique @default(uuid())
  username     String?        @unique
  email        String?        @unique
  passwordHash String?        @map("password_hash")
  avatar       String?
  displayName  String?        @map("display_name")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  authProviders AuthProvider[]
  sessions      Session[]

  @@map("users")
}

// 第三方登录绑定
model AuthProvider {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  provider    String   // github/google/wechat
  providerId  String   @map("provider_id") // 第三方用户ID
  profileData String?  @map("profile_data") // JSON: 头像、昵称等
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
  @@map("auth_providers")
}

// 应用注册表 - 接入 SSO 的应用
model Application {
  id            Int      @id @default(autoincrement())
  name          String
  clientId      String   @unique @map("client_id")
  clientSecret  String   @map("client_secret")
  redirectUris  String   @map("redirect_uris") // JSON array
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("applications")
}

// 会话管理
model Session {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  token        String    @unique
  appId        Int?      @map("app_id") // 来自哪个应用
  userAgent    String?   @map("user_agent")
  ipAddress    String?   @map("ip_address")
  expiresAt    DateTime  @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("sessions")
}
