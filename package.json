{
  "name": "sso-auth-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "SSO Authentication - Backend Server & Frontend SDK",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:generate": "npx prisma generate",
    "prisma:studio": "npx prisma studio",
    "build:frontend": "pnpm -r --filter './packages/*' run build",
    "build:core": "pnpm --filter @sso-auth/core build",
    "build:components": "pnpm --filter @sso-auth/components build",
    "build:embedded": "pnpm --filter @sso-auth/embedded build",
    "demo": "pnpm --filter demo dev",
    "clean": "pnpm -r run clean"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.2",
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "prisma": "^6.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.4",
    "vite-plugin-dts": "^3.7.3"
  },
  "packageManager": "pnpm@8.15.4",
  "engines": {
    "node": ">=18"
  }
}
